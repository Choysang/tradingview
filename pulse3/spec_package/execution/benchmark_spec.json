      "0<=reserved_sell<=sellable<=total",
      "NAV=external capital+realized+unrealized+dividends-fees-tax",
      "failed event does not mutate state",
      "exact redelivery is no-op; conflicting identity rejected",
      "public amount reads ignore caller Decimal context",
      "effective_at in Asia/Shanghai matches account session; no pre-opening or premature session unlock"
    ],
    "not_independent": "three transports share one reducer; this is not validation by three independent accounting engines"
  },
