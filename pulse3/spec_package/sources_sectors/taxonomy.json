  "namespace_policy": {
    "stable_ids": true,
    "display_labels_are_not_identifiers": true,
    "official_codes_not_invented": true,
    "industry_sources": [
      "NS14",
      "NS15"
    ],
    "multi_label_membership": true,
    "effective_time_and_knowledge_time_required": true,
    "unknown_is_not_zero_or_false": true,
    "classification_is_not_strategy_validation": true
  },
  "tag_definition_contract": {
    "required": [
      "tag_id",
      "namespace",
      "definition_version",
      "display_name",
      "value_type",
      "semantics",
      "authority",
      "created_at"
    ],
    "conditional": [
      "unit",
      "allowed_values",
      "calculation_window",
      "calculation_method_version",
      "reference_universe_id",
      "threshold_policy_id"
    ],
    "change_rule": "Semantic changes create a new definition version; aliases do not rewrite history."
  },
  "tag_assignment_contract": {
    "required": [
      "assignment_id",
      "entity_type",
      "entity_id",
      "tag_id",
      "definition_version",
      "value",
      "effective_from",
      "known_from",
      "available_at",
      "provenance",
      "assignment_method"
    ],
    "nullable": [
      "effective_to",
      "known_to",
      "confidence",
      "supersedes_assignment_id"
    ],
    "assignment_methods": [
      "official_mapping",
      "provider_mapping",
      "deterministic_transform",
      "statistical_estimate",
      "model_inference",
      "manual_research"
    ],
    "invariants": [
      "available_at is bounded by the information actually available to the platform",
      "entity_id must not be fabricated for unresolved mentions",
      "model_inference cannot overwrite an official master-data fact",
      "historical query includes both effective and knowledge time"
    ]
  },
