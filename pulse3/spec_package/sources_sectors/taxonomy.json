  "routing_contract": {
    "ordered_gates": [
      {
        "gate": "market_capability",
        "checks": [
          "asset_type",
          "market",
          "board",
          "trading_status",
          "session",
          "horizon",
          "execution_grade"
        ]
      },
      {
        "gate": "data_readiness",
        "checks": [
          "exact_metric_namespace",
          "methodology_version",
          "required_field_presence",
          "source_coverage",
          "freshness_state",
          "PIT_availability"
        ]
      },
      {
        "gate": "strategy_qualification",
        "checks": [
          "lifecycle",
          "validation_certificate",
          "shared_execution_accounting_model_version"
        ]
      },
      {
        "gate": "component_composition",
        "checks": [
          "role_inputs_outputs",
          "duplicate_evidence_dependencies",
          "correlation_and_conflict_policy"
        ]
      },
      {
        "gate": "portfolio_context",
        "checks": [
          "cash",
          "holdings",
          "sellable_quantity",
          "cost_basis",
          "account_snapshot_id"
        ]
      }
    ],
    "missing_input_policy": "Reject route or use an independently validated explicit fallback variant; never silently substitute zero.",
    "route_result_required": [
      "route_id",
      "decision_as_of",
      "input_snapshot_id",
      "taxonomy_versions",
      "eligible_components",
      "excluded_components_with_reasons",
      "composition_policy_version"
    ]
  },
