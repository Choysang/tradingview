  "reuse_not_duplicate": [
    "No raw-body table: use ingest.raw_object and source-paired FK.",
    "No second source health/cursor table: use ingest.source_health and ingest.source_cursor.",
    "No second industry membership table: use core.taxonomy_node and core.instrument_tag with snapshots.",
    "No second stock ranking table: use decision.ranking_run / ranking_entry.",
    "sector_rank_entry ranks taxonomy nodes only; parent scope must be sector_overview.",
    "No independent execution ledger or fill model is introduced."
  ],
  "publication_gates": [
    {
      "gate_id": "SS-G01",
      "enforcement": "service_transaction_required",
      "rule": "Claim availability is no earlier than actual evidence/parse completion. Observed historical use filters actual available_at; explicitly registered reconstruction uses policy_usable_at with availability_policy_version and latency assumptions without rewriting actual timestamps."
    },
    {
      "gate_id": "SS-G02",
      "enforcement": "service_transaction_required",
      "rule": "Event dependencies refer to exact claim versions and determine event earliest availability."
    },
    {
      "gate_id": "SS-G03",
      "enforcement": "service_transaction_required",
      "rule": "All publication snapshots and release components meet shared READY/coverage/PIT rules."
    },
    {
      "gate_id": "SS-G04",
      "enforcement": "service_transaction_required",
      "rule": "Pool state transition uses per(pool_id,instrument_id) lock or compare-and-set; previous_state and event_sequence match actual prior event; policy permits transition."
    },
    {
      "gate_id": "SS-G05",
      "enforcement": "service_transaction_required",
      "rule": "Actionable pool event plan instrument, release, account scope and precise plan version must agree."
    },
    {
      "gate_id": "SS-G06",
      "enforcement": "sector_entry_and_parent_triggers_plus_PIT_publication_validator",
      "rule": "SQL triggers enforce parent scope=sector_overview, one rank_kind, taxonomy/version/member snapshot equality and immutable READY/SUPERSEDED entries under the shared release lock; the publication service additionally proves snapshot readiness, coverage and PIT availability."
    },
    {
      "gate_id": "SS-G07",
      "enforcement": "core_ranking_entry_trigger",
      "rule": "Core guard_ranking_entry rejects stock ranking_entry under sector_overview; the extension separately guards sector rows and later parent metadata changes."
    },
    {
      "gate_id": "SS-G08",
      "enforcement": "service_transaction_required",
      "rule": "Seat identity version must be available by research snapshot and applicable to the disclosure period; unresolved names cannot be forced to stable IDs."
    },
    {
      "gate_id": "SS-G09",
      "enforcement": "service_transaction_required",
      "rule": "Overlapping multi-day and one-day LHB reports remain separate; derived aggregates prove non-overlapping scope before summation."
    },
    {
      "gate_id": "SS-G10",
      "enforcement": "schema_validator_required",
      "rule": "Every JSON payload uses the named registered JSON Schema version; jsonb_typeof alone does not implement field-level validation."
    },
    {
      "gate_id": "SS-G11",
      "enforcement": "source_adapter_and_reconciler_required",
      "rule": "Community and funding revisions retain source IDs, verified units, methodology and actual observation availability."
    },
    {
      "gate_id": "SS-G12",
      "enforcement": "dependency_invalidation_required",
      "rule": "Withdrawal/correction triggers rebuilding affected feature, ranking and trade-plan versions before promoting a replacement release."
    }
