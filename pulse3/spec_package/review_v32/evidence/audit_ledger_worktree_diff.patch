+def test_session_cut_waits_for_after_hours_volume_to_finish() -> None:
+    from datetime import datetime as dt, timezone
+
+    # Since 2026-07-06 all main-board A shares have a 15:05-15:30
+    # fixed-price session. Its volume still changes the daily bar.
+    for hour, minute, second in [(15, 5, 0), (15, 15, 0), (15, 29, 59)]:
+        instant = dt(2026, 7, 6, hour, minute, second, tzinfo=sync.CST)
+        assert sync.session_cut(instant) == date(2026, 7, 6)
+        assert sync.session_cut(instant.astimezone(timezone.utc)) == date(2026, 7, 6)
+    assert sync.session_cut(dt(2026, 7, 6, 15, 30, tzinfo=sync.CST)) is None
+
+
