diff --git a/backend/tests/test_news_alerts.py b/backend/tests/test_news_alerts.py
index b80260b..7a199f1 100644
--- a/backend/tests/test_news_alerts.py
+++ b/backend/tests/test_news_alerts.py
@@ -395,6 +395,58 @@ def test_point_in_time_membership_keeps_a_future_joiner_out(tmp_path: Path):
 
 # --- dedup, restart, incremental reading ----------------------------------------------------------
 
+@pytest.mark.parametrize("storage", ["raw", "parquet"])
+@pytest.mark.parametrize("restart", [False, True])
+def test_failed_judgement_is_retried_without_repeating_successes(
+    day_dir: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, storage: str, restart: bool,
+):
+    items = [
+        {"item_id": "901", "title": "公司收到证监会立案告知书", "body": "", "codes": ["600513"]},
+        {"item_id": "902", "title": "公司收到问询函", "body": "", "codes": ["600513"]},
+        {"item_id": "903", "title": "今日天气晴朗", "body": "", "codes": []},
+    ]
+    received = "2026-11-06T00:05:00+00:00"
+    if storage == "raw":
+        write_raw(day_dir, [{"source": "ths.724", "received_at": received, "items": items}])
+    else:
+        rows = [{"source_id": "ths.724", **it,
+                 "revision_id": A.revision_id(it["item_id"], it["title"], it["body"]),
+                 "received_at": datetime.fromisoformat(received)} for it in items]
+        (day_dir / "messages").mkdir()
+        pl.DataFrame(rows, schema_overrides={"received_at": pl.Datetime("ms", "UTC")}).write_parquet(
+            day_dir / "messages" / "part-retry.parquet")
+
+    calls = {it["item_id"]: 0 for it in items}
+
+    def instrument(eng: A.AlertEngine) -> None:
+        original = eng.judge
+
+        def judge(m: A.Msg):
+            calls[m.item_id] += 1
+            if m.item_id == "901" and calls[m.item_id] == 1:
+                raise RuntimeError("transient classification failure")
+            return original(m)
+
+        monkeypatch.setattr(eng, "judge", judge)
+
+    first = engine(day_dir, tmp_path)
+    instrument(first)
+    assert first.step() == 2  # one alert plus one successfully classified neutral message
+    keys = {it["item_id"]: "ths.724|" + A.revision_id(it["item_id"], it["title"], it["body"]) for it in items}
+    assert keys["901"] not in first.seen
+    assert {keys["902"], keys["903"]} <= first.seen
+    assert [r["item_id"] for r in rows_of(day_dir)] == ["902"]
+
+    again = engine(day_dir, tmp_path) if restart else first
+    if restart:
+        instrument(again)
+    assert again.step() == 1
+    assert {r["item_id"] for r in rows_of(day_dir)} == {"901", "902"}
+    assert calls == {"901": 2, "902": 1, "903": 1}
+    assert again.step() == 0
+    assert len(rows_of(day_dir)) == 2
+
+
 def test_restart_does_not_alert_again(day_dir: Path, tmp_path: Path):
     write_raw(day_dir, answers())
     engine(day_dir, tmp_path).step()
