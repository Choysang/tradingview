{
  "version": "3.1.0-candidate",
  "as_of": "2026-11-11",
  "status": "specification_not_runtime_implementation",
  "new_tables": 0,
  "new_http_operations": 0,
  "extensions": [
    {
      "proposal_id": "SP04",
      "name": "session_forecast_card",
      "status": "design_candidate",
      "why": "把四时段复盘从每日重新叙述变成不可覆盖的可评分预测；区分原文事实、概率准确性与交易增益。",
      "existing_bindings": [
        {
          "table": "intelligence.claim_revision",
          "columns": [
            "claim_revision_id",
            "subject_kind",
            "subject_key",
            "predicate",
            "object_payload",
            "claim_schema_version",
            "assertion_type",
            "claim_status",
            "available_at"
          ]
        },
        {
          "table": "intelligence.claim_evidence",
          "columns": [
            "claim_revision_id",
            "document_revision_id",
            "evidence_ordinal",
            "evidence_span",
            "relation"
          ]
        },
        {
          "table": "market.feature_result",
          "columns": [
            "feature_id",
            "definition_version",
            "full_key",
            "snapshot_id",
            "decision_as_of",
            "result_uri",
            "result_hash",
            "computed_at"
          ]
        }
      ],
      "api_bindings": [
        {
          "operation_id": "getStockEvidence",
          "schema_def": "EvidenceClaim",
          "existing_properties": [
            "object_payload",
            "claim_schema_version",
            "claim_revision_id",
            "available_at"
          ]
        },
        {
          "operation_id": "getStockWorkspace",
          "schema_def": "Workspace",
          "existing_properties": [
            "features"
          ]
        },
        {
          "operation_id": "getStockCommunity",
          "schema_def": "CommunityObservation",
          "existing_properties": [
            "analysis_payload",
            "analysis_schema_version",
            "sampled_at",
            "coverage_status"
          ]
        }
      ],
      "proposed_payload_contracts": [
        {
          "name": "CommunityForecastPayload",
          "envelope": "EvidenceClaim.object_payload",
          "requires_registration": true,
          "fields": [
            {
              "name": "forecast_target_ref",
              "type": "ArtifactRef",
              "meaning": "不可变的目标定义，明确证券、事件/收益目标、比较基准和到期判定"
            },
            {
              "name": "resolution_window_start",
              "type": "Timestamp",
              "meaning": "结果观测窗口起点"
            },
            {
              "name": "resolution_window_end",
              "type": "Timestamp",
              "meaning": "结果窗口终点，必须晚于起点"
            },
            {
              "name": "prediction_probability",
              "type": "Decimal|null",
              "meaning": "仅原文明确概率时可填，范围0至1，不能从情绪词臆测"
            },
            {
              "name": "probability_origin",
              "type": "source_explicit|not_provided",
              "meaning": "非显式概率不可评分"
            },
            {
              "name": "probability_evidence_ordinal",
              "type": "PositiveInteger|null",
              "meaning": "存在概率时引用外层evidence中的原文跨度"
            },
            {
              "name": "session_kind",
              "type": "versioned calendar label",
              "meaning": "从交易日历解析盘前/盘中/午间/盘后，不另写一套固定会话规则"
            },
            {
              "name": "resolution_policy_version",
              "type": "string",
              "meaning": "先冻结如何判定结果，不能看结果再改目标"
            }
          ],
          "note": "这些都是拟新增载荷字段，不是当前主schema的顶层字段。由root最终统一注册和命名。"
        },
        {
          "name": "CommunityForecastResolutionArtifact",
          "envelope": "FeatureResult.artifact",
          "requires_registration": true,
          "fields": [
            {
              "name": "claim_revision_id",
              "type": "UUID",
              "meaning": "被评分的原预测精确版本"
            },
            {
              "name": "resolution_state",
              "type": "pending|resolved|not_scorable|disputed",
              "meaning": "结果未知不等于错误"
            },
            {
              "name": "outcome_snapshot_ref",
              "type": "ArtifactRef|null",
              "meaning": "到期结果版本及hash"
            },
            {
              "name": "resolved_at",
              "type": "Timestamp|null",
              "meaning": "真正完成评分时点"
            },
            {
              "name": "brier_error",
              "type": "Decimal|null",
              "meaning": "仅明确二元目标和原始概率时计算(p-y)^2"
            },
            {
              "name": "reason",
              "type": "string|null",
              "meaning": "未到期、无概率、缺证据等具体原因"
            }
          ]
        }
      ],
      "migration_boundary": "无需新增SQL表或HTTP字段；需注册载荷schema、实现Repository跨引用校验与artifact读取。现有research.experiment_run要求非空instance_id，普通观点评分不能伪造策略实例。"
    },
    {
      "proposal_id": "SP13",
      "name": "layer_capability_policy",
      "status": "design_candidate",
      "why": "避免回放和图表看起来完整、实际依赖缺失或低粒度数据；Lightweight Charts不提供行情和内置指标。",
      "existing_bindings": [
        {
          "table": "core.source_endpoint",
          "columns": [
            "source_id",
            "endpoint_id",
            "source_schema_version",
            "mapping_version",
            "policy_document"
          ]
        },
        {
          "table": "market.dataset_manifest",
          "columns": [
            "contract_id",
            "schema_version",
            "coverage_document",
            "content_hash"
          ]
        },
        {
          "table": "market.feature_result",
          "columns": [
            "feature_id",
            "full_key",
            "result_uri",
            "result_hash"
          ]
        }
      ],
      "api_bindings": [
        {
          "operation_id": "getStockWorkspace",
          "schema_def": "Workspace",
          "existing_properties": [
            "features",
            "chart_window_refs"
          ]
        },
        {
          "operation_id": "getDataStatus",
          "schema_def": "SourceHealth",
          "existing_properties": [
            "runtime_state",
            "freshness_state",
            "last_canonical_ready_at"
          ]
        }
      ],
      "proposed_payload_contracts": [
        {
          "name": "LayerCapabilityArtifact",
          "envelope": "FeatureResult.artifact",
          "requires_registration": true,
          "fields": [
            {
              "name": "layer_id",
              "type": "string",
              "meaning": "如auction_imbalance、replay_comments、volume_profile"
            },
            {
              "name": "input_snapshot_refs",
              "type": "ArtifactRef[]",
              "meaning": "实际使用的数据版本"
            },
            {
              "name": "capability_mode",
              "type": "observed|estimated|unavailable",
              "meaning": "观测、明确估算与不可用分别展示"
            },
            {
              "name": "methodology_version",
              "type": "string|null",
              "meaning": "估算和渲染语义版本"
            },
            {
              "name": "coverage_reason",
              "type": "string",
              "meaning": "所缺粒度/时间窗口，或覆盖范围说明"
            }
          ]
        }
      ],
      "migration_boundary": "SourceHealth没有capabilities字段。不得向getDataStatus偷加字段；首期通过内部政策和带严格schema的图层artifact使用。如需直接能力API则另做DTO版本。"
    },
    {
      "proposal_id": "SP15",
      "name": "etf_observation_lanes",
      "status": "design_candidate",
      "why": "ETF成交额、份额变化、申赎执行、申赎额度、投资者身份属于不同事实，分栏防止错误字段串用。",
      "existing_bindings": [
        {
          "table": "intelligence.funding_observation",
          "columns": [
            "funding_observation_id",
            "metric_namespace",
            "metric_name",
            "methodology_id",
            "methodology_version",
            "measurement_class",
            "trade_or_order_basis",
            "observation_window_start",
            "observation_window_end",
            "canonical_value",
            "canonical_unit",
            "available_at",
            "field_quality"
          ]
        }
      ],
      "api_bindings": [
        {
          "operation_id": "getStockFundFlow",
          "schema_def": "FundFlowObservation",
