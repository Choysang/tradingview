      "proposed_metric_names": [
        "etf_secondary_turnover_amount_cny",
        "etf_disclosed_share_change",
        "etf_primary_creation_executed",
        "etf_primary_redemption_executed",
        "etf_primary_creation_quota"
      ],
      "metric_names_are": "proposed explicit registry identifiers; not existing SQL columns and not active feeds",
      "migration_boundary": "字段结构可复用，不新增表。每种metric需独立登记口径和来源；缺实际申赎就是null，额度字段不得映射为执行字段。"
    },
    {
      "proposal_id": "SP17",
      "name": "convertible_underlying_relation",
      "status": "design_candidate",
      "why": "补充已知债股关系的跨品种观察，先检验对主板正股选股的边际价值，不把未经验证先行性写成套利。",
      "existing_bindings": [
        {
          "table": "core.instrument",
          "columns": [
            "instrument_id",
            "instrument_type",
            "currency"
          ]
        },
        {
          "table": "intelligence.claim_revision",
          "columns": [
            "subject_kind",
            "subject_key",
            "predicate",
            "object_payload",
            "claim_schema_version",
            "available_at"
          ]
        },
        {
          "table": "intelligence.claim_evidence",
          "columns": [
            "claim_revision_id",
            "document_revision_id",
            "evidence_span"
          ]
        },
        {
          "table": "market.feature_result",
          "columns": [
            "full_key",
            "snapshot_id",
            "result_uri",
            "result_hash"
          ]
        }
      ],
      "api_bindings": [
        {
          "operation_id": "getStockEvidence",
          "schema_def": "EvidenceClaim",
          "existing_properties": [
            "subject_kind",
            "subject_key",
            "predicate",
            "object_payload",
            "claim_schema_version"
          ]
        },
        {
          "operation_id": "getStockWorkspace",
          "schema_def": "FeatureResult",
          "existing_properties": [
            "key",
            "artifact"
          ]
        }
      ],
      "proposed_payload_contracts": [
        {
          "name": "ConvertibleUnderlyingPayload",
          "envelope": "EvidenceClaim.object_payload",
          "requires_registration": true,
          "fields": [
            {
              "name": "underlying_instrument_id",
              "type": "UUID",
              "meaning": "已登记正股稳定身份；债券身份在外层subject_key"
            },
            {
              "name": "effective_from",
              "type": "Timestamp",
              "meaning": "债股关系业务生效起点"
            },
            {
              "name": "effective_to",
              "type": "Timestamp|null",
              "meaning": "半开有效区间终点，未结束为null"
            }
          ],
          "outer_binding": {
            "subject_kind": "instrument",
            "subject_key": "convertible instrument UUID",
            "predicate": "convertible_underlying_of"
          },
          "cross_reference_checks": [
            "subject_key和underlying_instrument_id确实在core.instrument存在且不同",
            "外层证券类型为已登记的convertible instrument类别，内层为equity",
            "evidence精确指向披露证据，available_at不提前",
            "effective_to为空或晚于effective_from"
          ]
        }
      ],
      "migration_boundary": "无需新SQL表或顶层HTTP字段，但JSON内ID没有自动FK，必须Repository核对。需要债券行情量纲/条款的独立源合同；当前CanonicalQuote.volume_shares和A股交易账户不能被冒称已支持债券执行。"
    }
  ],
  "acceptance_scenarios": [
    {
      "scenario_id": "SPT01",
      "proposal_id": "SP02",
      "input": "只有官方原始公告且超过180秒",
