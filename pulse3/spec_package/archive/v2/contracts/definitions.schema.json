{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pulse/contracts/definitions.schema.json",
  "title": "Pulse contract seeds",
  "description": "Seed contract version 1.0.0-seed.1. Root validates the hypothetical fixture; individual contracts are in $defs. This is not a trading engine.",
  "$ref": "#/$defs/Fixture",
  "$defs": {
    "CommonObject": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0-seed.1"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "producer_version": {
          "type": "string",
          "minLength": 1
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "schema_version",
        "object_id",
        "created_at",
        "as_of",
        "producer_version",
        "causation_id",
        "correlation_id",
        "idempotency_key"
      ]
    },
    "VersionRef": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "version"
      ],
      "additionalProperties": false
    },
    "PlanRef": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plan_id",
        "version"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "additionalProperties": false
    },
    "Unit": {
      "type": "string",
      "enum": [
        "CNY_per_share",
        "CNY",
        "shares",
        "ratio",
        "percent",
        "count",
        "seconds",
        "dimensionless"
      ]
    },
    "Clock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quote"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bar_close"
            },
            "timeframe": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "30m",
                "60m",
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ]
            }
          },
          "required": [
            "kind",
            "timeframe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "session_open"
            },
            "session_kind": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "session_kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event_available"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "scheduled"
            },
            "schedule_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "kind",
            "schedule_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FeatureRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "feature"
        },
        "feature_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "definition_version": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "feature_id",
        "definition_version",
        "instrument_id",
        "unit",
        "timeframe"
      ],
      "additionalProperties": false
    },
    "Constant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "constant"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "Operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/FeatureRef"
        },
        {
          "$ref": "#/$defs/Constant"
        }
      ]
    },
    "AllCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "all"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1
        }
      },
      "required": [
        "node",
        "clock",
        "children"
      ],
      "additionalProperties": false
    },
    "AnyCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "any"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1
        }
      },
      "required": [
        "node",
        "clock",
        "children"
      ],
      "additionalProperties": false
    },
    "NotCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "not"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "child": {
          "$ref": "#/$defs/Condition"
        }
      },
      "required": [
        "node",
        "clock",
        "child"
      ],
      "additionalProperties": false
    },
    "CompareCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "compare"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "operator": {
          "type": "string",
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte",
            "eq"
          ]
        },
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        }
      },
      "required": [
        "node",
        "clock",
        "operator",
        "left",
        "right"
      ],
      "additionalProperties": false
    },
    "CrossesCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "crosses"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "direction": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ]
        },
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        },
        "previous_observation": {
          "type": "object",
          "properties": {
            "selection": {
              "const": "previous_valid"
            },
            "max_age_ms": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "selection",
            "max_age_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "clock",
        "direction",
        "left",
        "right",
        "previous_observation"
      ],
      "additionalProperties": false
    },
    "WithinSessionCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "within_session"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "session_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "node",
        "clock",
        "session_kinds"
      ],
      "additionalProperties": false
    },
    "EventStateCondition": {
      "type": "object",
      "properties": {
        "node": {
          "const": "event_state"
        },
        "clock": {
          "$ref": "#/$defs/Clock"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "minimum_revision": {
          "type": "integer",
          "minimum": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "node",
        "clock",
        "event_id",
        "minimum_revision",
        "states"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/NotCondition"
        },
        {
          "$ref": "#/$defs/CompareCondition"
        },
        {
          "$ref": "#/$defs/CrossesCondition"
        },
        {
          "$ref": "#/$defs/WithinSessionCondition"
        },
        {
          "$ref": "#/$defs/EventStateCondition"
        }
      ],
      "description": "Three-valued semantics: true, false, unknown. Unknown never means trigger satisfied. No SQL, Python or eval strings."
    },
    "HoldingHorizon": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "trading_sessions"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "counting_rule": {
              "type": "string",
              "enum": [
                "after_first_fill_session",
                "entry_session_inclusive"
              ]
            },
            "holding_anchor": {
              "type": "string",
              "enum": [
                "first_fill_at",
                "latest_fill_at",
                "per_lot_first_fill_at"
              ]
            }
          },
          "required": [
            "unit",
            "count",
            "counting_rule",
            "holding_anchor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "duration"
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "holding_anchor": {
              "type": "string",
              "enum": [
                "first_fill_at",
                "latest_fill_at",
                "per_lot_first_fill_at"
              ]
            }
          },
          "required": [
            "unit",
            "seconds",
            "holding_anchor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SizingSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fixed_quantity"
            },
            "quantity_shares": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "mode",
            "quantity_shares"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "cash_budget"
            },
            "budget": {
              "$ref": "#/$defs/Money"
            },
            "lot_size_shares": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "mode",
            "budget",
            "lot_size_shares"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PriceZone": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "price_basis": {
          "const": "raw"
        },
        "lower": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "Decimal raw-market price; positivity and tick size are semantic checks."
        },
        "upper": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "Decimal raw-market price; positivity and tick size are semantic checks."
        }
      },
      "required": [
        "currency",
        "price_basis",
        "lower",
        "upper"
      ],
      "additionalProperties": false
    },
    "TriggerPolicy": {
      "type": "object",
      "properties": {
        "trigger_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "fire_mode": {
          "type": "string",
          "enum": [
            "on_transition_to_true",
            "repeated_while_true"
          ]
        },
        "unknown_policy": {
          "const": "do_not_fire"
        },
        "rearm": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "never",
                "after_false",
                "after_cooldown"
              ]
            },
            "cooldown_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "mode",
            "cooldown_ms"
          ],
          "additionalProperties": false
        },
        "max_fires": {
          "type": "integer",
          "minimum": 1
        },
        "min_interval_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "trigger_id",
        "fire_mode",
        "unknown_policy",
        "rearm",
        "max_fires",
        "min_interval_ms"
      ],
      "additionalProperties": false,
      "description": "Transition key: plan_id, plan_version, trigger_id, account_id, transition_sequence. A condition becoming true does not imply a fill."
    },
    "HardDependency": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "plan",
                "account"
              ]
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "object_id",
            "expected_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "instrument_state",
                "market_rules",
                "evidence_revision",
                "strategy",
                "model_policy",
                "universe_policy",
                "cost_profile",
                "execution_policy"
              ]
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "expected_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "object_id",
            "expected_version"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SoftDependency": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quote"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reference_price": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "description": "Decimal raw-market price; positivity and tick size are semantic checks."
            }
          },
          "required": [
            "kind",
            "object_id",
            "expected_version",
            "observed_at",
            "reference_price"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rank"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "object_id",
            "expected_version",
            "observed_at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FeatureRequirement": {
      "type": "object",
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "definition_version": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "feature_id",
        "definition_version",
        "unit"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "hypothetical_fixture",
            "paper",
            "article",
            "video",
            "code",
            "user_hypothesis"
          ]
        }
      },
      "required": [
        "source_uri",
        "source_version",
        "source_kind"
      ],
      "additionalProperties": false
    },
    "StrategySpec": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model_policy"
              }
            }
          },
          "then": {
            "properties": {
              "model_policy_ref": {
                "$ref": "#/$defs/VersionRef"
              }
            }
          },
          "else": {
            "properties": {
              "model_policy_ref": {
                "type": "null"
              }
            }
          }
        }
      ],
      "type": "object",
      "properties": {
        "strategy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "rule",
            "model_policy"
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "minItems": 1
        },
        "universe_policy_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "required_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureRequirement"
          },
          "minItems": 1
        },
        "decision_clock": {
          "$ref": "#/$defs/Clock"
        },
        "entry_conditions": {
          "$ref": "#/$defs/Condition"
        },
        "exit_conditions": {
          "$ref": "#/$defs/Condition"
        },
        "sizing": {
          "$ref": "#/$defs/SizingSpec"
        },
        "holding_horizon": {
          "$ref": "#/$defs/HoldingHorizon"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Constant"
          }
        },
        "execution_requirements": {
          "type": "object",
          "properties": {
            "minimum_data_grade": {
              "type": "string",
              "enum": [
                "D1",
                "M1",
                "T1",
                "L2"
              ]
            },
            "market_rules_ref": {
              "$ref": "#/$defs/VersionRef"
            },
            "execution_policy_ref": {
              "$ref": "#/$defs/VersionRef"
            },
            "buy_lot_size_shares": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "minimum_data_grade",
            "market_rules_ref",
            "execution_policy_ref",
            "buy_lot_size_shares"
          ],
          "additionalProperties": false
        },
        "model_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "strategy_id",
        "version",
        "kind",
        "hypothesis",
        "provenance",
        "universe_policy_ref",
        "required_features",
        "decision_clock",
        "entry_conditions",
        "exit_conditions",
        "sizing",
        "holding_horizon",
        "parameters",
        "execution_requirements",
        "model_policy_ref"
      ],
      "unevaluatedProperties": false
    },
    "PlanProposal": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonObject"
        }
      ],
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "proposed_plan_id": {
          "type": "string",
