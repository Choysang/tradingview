# Real mode: Vite proxies /v1 to the pulse3 API.
VITE_API_PROXY_TARGET=http://127.0.0.1:8200
# Dev mock (contract-valid synthetic fixtures, bannered). Set to 1 to enable.
VITE_USE_MOCK=0
# Values the contract does not enumerate (slot key, horizons, taxonomies, quote policy) are served by the API at
# /app-config.json (derived from the published release; PULSE_SLOT_KEY / PULSE_APP_CONFIG_FILE on the API side).
# Any VITE_* below overrides the served value. Default slot is "main".
# VITE_SLOT_KEY=main
# Optional JSON overrides for items the contract does not enumerate (see README "Client config").
# VITE_HORIZONS=[{"key":"short","label":"短线","horizonId":"short_term","forecastTarget":"excess_return_5d"}]
# VITE_TAXONOMIES=[{"id":"industry","version":1,"label":"行业"}]
# VITE_ACCOUNT_ID=
# VITE_ACCOUNT_VERSION=
# VITE_VALUATION_SNAPSHOT_ID=
# VITE_LAYOUT_ID=
# VITE_LEAGUE_ID=
# VITE_LEAGUE_VERSION=
# VITE_QUOTE_POLICY_VERSION=
