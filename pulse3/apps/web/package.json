{
  "name": "pulse3-web",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "Pulse3 retail workbench (W08): React 19 + Vite, contract-generated client",
  "scripts": {
    "gen:api": "openapi-typescript ../../src/pulse/contracts/data/openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:dump": "tsx mock/dump.ts",
    "preview:mock": "vite preview --mode mock",
    "mock:env": "tsx mock/envgen.ts > .env.mock",
    "mock:validate": "tsx mock/dump.ts && cd ../.. && uv run python apps/web/scripts/validate_mock.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lightweight-charts": "5.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
