{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:contracts:backfill:nexus:v1",
  "title": "Pulse 3.5 Nexus Unified Quant, Microstructure, TradingView Pro, Real-Time RAPTOR & Swiss Arena Contract",
  "x-contract-version": "2.0.0",
  "$defs": {
    "DecStr": { "type": ["string", "null"] },
    "RatingLabel": {
      "type": "string",
      "enum": ["strong_sell", "sell", "neutral", "buy", "strong_buy", "unavailable"]
    },
    "SectorRole": {
      "type": "string",
      "enum": ["leader_1", "leader_2", "core_capacity", "pioneer", "catchup", "member"]
    },
    "GaugeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "score", "buy_count", "neutral_count", "sell_count", "total_count", "items"],
      "properties": {
        "label": { "$ref": "#/$defs/RatingLabel" },
        "score": { "$ref": "#/$defs/DecStr" },
        "buy_count": { "type": "integer", "minimum": 0 },
        "neutral_count": { "type": "integer", "minimum": 0 },
        "sell_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "signal"],
            "properties": {
              "name": { "type": "string" },
              "value": { "$ref": "#/$defs/DecStr" },
              "signal": { "type": "string", "enum": ["buy", "neutral", "sell", "unavailable"] }
            }
          }
        }
      }
    },
    "TimeframeTechnicalRating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeframe", "bar_count", "last_bar_date", "summary", "moving_averages", "oscillators"],
      "properties": {
        "timeframe": { "type": "string", "enum": ["1d", "1w", "1mo", "1y"] },
        "bar_count": { "type": "integer", "minimum": 0 },
        "last_bar_date": { "type": ["string", "null"] },
        "summary": { "$ref": "#/$defs/GaugeGroup" },
        "moving_averages": { "$ref": "#/$defs/GaugeGroup" },
        "oscillators": { "$ref": "#/$defs/GaugeGroup" }
      }
    },
    "PivotLevelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "p", "r1", "r2", "r3", "r4", "s1", "s2", "s3", "s4"],
      "properties": {
        "method": { "type": "string", "enum": ["traditional", "classic", "fibonacci", "camarilla", "woodie", "demark"] },
        "p": { "$ref": "#/$defs/DecStr" },
        "r1": { "$ref": "#/$defs/DecStr" },
        "r2": { "$ref": "#/$defs/DecStr" },
        "r3": { "$ref": "#/$defs/DecStr" },
        "r4": { "$ref": "#/$defs/DecStr" },
        "s1": { "$ref": "#/$defs/DecStr" },
        "s2": { "$ref": "#/$defs/DecStr" },
        "s3": { "$ref": "#/$defs/DecStr" },
        "s4": { "$ref": "#/$defs/DecStr" }
      }
    },
    "VpvrProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available", "lookback_bars", "poc", "vah", "val", "winner_ratio",
        "avg_chip_cost", "concentration_90", "hvn_zones", "lvn_zones", "bins"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "lookback_bars": { "type": "integer", "minimum": 0 },
        "poc": { "$ref": "#/$defs/DecStr" },
        "vah": { "$ref": "#/$defs/DecStr" },
        "val": { "$ref": "#/$defs/DecStr" },
        "winner_ratio": { "$ref": "#/$defs/DecStr" },
        "avg_chip_cost": { "$ref": "#/$defs/DecStr" },
        "concentration_90": { "$ref": "#/$defs/DecStr" },
        "hvn_zones": { "type": "array", "items": { "type": "string" } },
        "lvn_zones": { "type": "array", "items": { "type": "string" } },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["low", "high", "mid", "volume_share", "up_share", "is_value_area", "is_poc", "node_kind"],
            "properties": {
              "low": { "type": "string" },
              "high": { "type": "string" },
              "mid": { "type": "string" },
              "volume_share": { "type": "string" },
              "up_share": { "type": "string" },
              "is_value_area": { "type": "boolean" },
              "is_poc": { "type": "boolean" },
              "node_kind": { "type": "string", "enum": ["poc", "hvn", "lvn", "normal"] }
            }
          }
        }
      }
    },
    "NeurosymbolicGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_passed", "crumble_risk_level", "spread_to_cost_multiple", "violations", "checks"],
      "properties": {
        "all_passed": { "type": "boolean" },
        "crumble_risk_level": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "spread_to_cost_multiple": { "$ref": "#/$defs/DecStr" },
        "violations": { "type": "array", "items": { "type": "string" } },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guard_id", "passed", "detail"],
            "properties": {
              "guard_id": { "type": "string" },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "IntradayTPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_id", "archetype_name", "paper_ref", "recommended_direction",
        "reference_price", "reservation_price", "forward_buy_price", "forward_sell_price",
        "reverse_sell_price", "reverse_buyback_price", "abort_stop_price",
        "base_sellable_shares", "available_cash_cny", "recommended_lots", "recommended_shares",
        "round_trip_fee_bps", "min_profitable_spread_pct", "expected_cost_reduction_pct",
        "cash_non_overdraft_verified", "t1_lock_verified", "crumble_risk_level",
        "neurosymbolic_guards", "execution_notes", "backtest_summary"
      ],
      "properties": {
        "archetype_id": { "type": "string" },
        "archetype_name": { "type": "string" },
        "paper_ref": { "type": "string" },
        "recommended_direction": { "type": "string", "enum": ["forward_t", "reverse_t", "dual_vwap_t", "lock_hold", "exit_only", "unavailable"] },
        "reference_price": { "$ref": "#/$defs/DecStr" },
        "reservation_price": { "$ref": "#/$defs/DecStr" },
        "forward_buy_price": { "$ref": "#/$defs/DecStr" },
        "forward_sell_price": { "$ref": "#/$defs/DecStr" },
        "reverse_sell_price": { "$ref": "#/$defs/DecStr" },
        "reverse_buyback_price": { "$ref": "#/$defs/DecStr" },
        "abort_stop_price": { "$ref": "#/$defs/DecStr" },
        "base_sellable_shares": { "type": "integer", "minimum": 0 },
        "available_cash_cny": { "type": "string" },
        "recommended_lots": { "type": "integer", "minimum": 0 },
        "recommended_shares": { "type": "integer", "minimum": 0 },
        "round_trip_fee_bps": { "type": "string" },
        "min_profitable_spread_pct": { "type": "string" },
        "expected_cost_reduction_pct": { "$ref": "#/$defs/DecStr" },
        "cash_non_overdraft_verified": { "type": "boolean" },
        "t1_lock_verified": { "type": "boolean" },
        "crumble_risk_level": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "neurosymbolic_guards": { "$ref": "#/$defs/NeurosymbolicGuards" },
        "execution_notes": { "type": "array", "items": { "type": "string" } },
        "backtest_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessions_tested", "triggered_days", "win_rate", "cum_extra_return_pct", "vs_hold_delta_pct"],
          "properties": {
            "sessions_tested": { "type": "integer", "minimum": 0 },
            "triggered_days": { "type": "integer", "minimum": 0 },
            "win_rate": { "$ref": "#/$defs/DecStr" },
            "cum_extra_return_pct": { "$ref": "#/$defs/DecStr" },
            "vs_hold_delta_pct": { "$ref": "#/$defs/DecStr" }
          }
        }
      }
    },
    "GridPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "anchor_price", "lower_bound", "upper_bound", "upper_circuit_breaker",
        "lower_stop_breaker", "grid_count", "step_pct", "per_grid_lots", "per_grid_shares",
        "base_locked_shares", "rungs", "crumble_risk_level", "neurosymbolic_guards",
        "budget_status_note", "backtest"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["atr_adaptive", "geometric", "arithmetic", "budget_insufficient", "unavailable"] },
        "anchor_price": { "$ref": "#/$defs/DecStr" },
        "lower_bound": { "$ref": "#/$defs/DecStr" },
        "upper_bound": { "$ref": "#/$defs/DecStr" },
        "upper_circuit_breaker": { "$ref": "#/$defs/DecStr" },
        "lower_stop_breaker": { "$ref": "#/$defs/DecStr" },
        "grid_count": { "type": "integer", "minimum": 0 },
        "step_pct": { "$ref": "#/$defs/DecStr" },
        "per_grid_lots": { "type": "integer", "minimum": 0 },
        "per_grid_shares": { "type": "integer", "minimum": 0 },
        "base_locked_shares": { "type": "integer", "minimum": 0 },
        "rungs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level_index", "trigger_price", "action", "shares", "target_pair_price", "est_net_profit_cny"],
            "properties": {
              "level_index": { "type": "integer" },
              "trigger_price": { "type": "string" },
              "action": { "type": "string", "enum": ["buy_dip", "anchor", "sell_rally"] },
              "shares": { "type": "integer", "minimum": 0 },
              "target_pair_price": { "$ref": "#/$defs/DecStr" },
              "est_net_profit_cny": { "$ref": "#/$defs/DecStr" }
            }
          }
        },
        "crumble_risk_level": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "neurosymbolic_guards": { "$ref": "#/$defs/NeurosymbolicGuards" },
        "budget_status_note": { "type": ["string", "null"] },
        "backtest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessions_tested", "completed_round_trips", "grid_net_profit_cny",
            "cost_reduction_per_share_cny", "cost_reduction_pct", "vs_buy_hold_excess_pct", "max_capital_usage_pct"
          ],
          "properties": {
            "sessions_tested": { "type": "integer", "minimum": 0 },
            "completed_round_trips": { "type": "integer", "minimum": 0 },
            "grid_net_profit_cny": { "$ref": "#/$defs/DecStr" },
            "cost_reduction_per_share_cny": { "$ref": "#/$defs/DecStr" },
            "cost_reduction_pct": { "$ref": "#/$defs/DecStr" },
            "vs_buy_hold_excess_pct": { "$ref": "#/$defs/DecStr" },
            "max_capital_usage_pct": { "$ref": "#/$defs/DecStr" }
          }
        }
      }
    },
    "SessionPulse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_bucket", "label", "post_count", "unique_authors", "bullish_ratio", "divergence_index", "dominant_topic", "heat_state"],
      "properties": {
        "session_bucket": { "type": "string", "enum": ["pre_market", "intraday", "midday_break", "post_market"] },
        "label": { "type": "string" },
        "post_count": { "type": "integer", "minimum": 0 },
        "unique_authors": { "type": "integer", "minimum": 0 },
        "bullish_ratio": { "$ref": "#/$defs/DecStr" },
        "divergence_index": { "$ref": "#/$defs/DecStr" },
        "dominant_topic": { "type": "string" },
        "heat_state": { "type": "string", "enum": ["cold", "normal", "warming", "overheated_warning", "no_data"] }
      }
    },
    "RetailResonance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_posts", "template_spam_ratio", "abnormal_attention_z", "sir_contagion_slope", "crowd_state", "sessions", "claim_checks", "synthesized_judgment"],
      "properties": {
        "total_posts": { "type": "integer", "minimum": 0 },
        "template_spam_ratio": { "$ref": "#/$defs/DecStr" },
        "abnormal_attention_z": { "$ref": "#/$defs/DecStr" },
        "sir_contagion_slope": { "$ref": "#/$defs/DecStr" },
        "crowd_state": { "type": "string", "enum": ["overheated_reversal_risk", "healthy_divergence", "early_discovery", "quiet_ignored", "unavailable"] },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/SessionPulse" } },
        "claim_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["retail_claim", "verdict", "objective_evidence"],
            "properties": {
              "retail_claim": { "type": "string" },
              "verdict": { "type": "string", "enum": ["supported_by_facts", "contradicted_by_facts", "unverified_noise"] },
              "objective_evidence": { "type": "string" }
            }
          }
        },
        "synthesized_judgment": { "type": "string" }
      }
    },
    "SeatBattleAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_recent_lhb", "report_date", "lhasa_buyer_count", "one_day_raider_count",
        "synergy_leader_count", "quant_seat_count", "net_buy_amount_cny", "lhasa_ratio",
        "battle_verdict", "fake_institution_check", "seats", "opponent_strategy"
      ],
      "properties": {
        "has_recent_lhb": { "type": "boolean" },
        "report_date": { "type": ["string", "null"] },
        "lhasa_buyer_count": { "type": "integer", "minimum": 0 },
        "one_day_raider_count": { "type": "integer", "minimum": 0 },
        "synergy_leader_count": { "type": "integer", "minimum": 0 },
        "quant_seat_count": { "type": "integer", "minimum": 0 },
        "net_buy_amount_cny": { "$ref": "#/$defs/DecStr" },
        "lhasa_ratio": { "$ref": "#/$defs/DecStr" },
        "battle_verdict": { "type": "string", "enum": ["synergy_bullish", "neutral_turnover", "retail_trap_bearish", "raider_dump_warning", "no_lhb_data"] },
        "fake_institution_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["institution_present", "verdict", "risk_score", "reasons"],
          "properties": {
            "institution_present": { "type": "boolean" },
            "verdict": { "type": "string", "enum": ["real_institution_likely", "quant_fake_institution_risk", "mixed_uncertain", "none"] },
            "risk_score": { "$ref": "#/$defs/DecStr" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat_name", "side", "category", "net_amount_cny", "persona_code",
              "persona_label", "style_summary", "empirical_d1_gap_pct", "empirical_d5_excess_pct", "counter_tactic"
            ],
            "properties": {
              "seat_name": { "type": "string" },
              "side": { "type": "string", "enum": ["buy", "sell", "both"] },
              "category": { "type": "string" },
              "net_amount_cny": { "$ref": "#/$defs/DecStr" },
              "persona_code": { "type": "string" },
              "persona_label": { "type": "string" },
              "style_summary": { "type": "string" },
              "empirical_d1_gap_pct": { "$ref": "#/$defs/DecStr" },
              "empirical_d5_excess_pct": { "$ref": "#/$defs/DecStr" },
              "counter_tactic": { "type": "string" }
            }
          }
        },
        "opponent_strategy": { "type": "string" }
      }
    },
    "ChartSignalMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "position", "shape", "tone", "text"],
      "properties": {
        "time": { "type": "string" },
        "position": { "type": "string", "enum": ["aboveBar", "belowBar"] },
        "shape": { "type": "string", "enum": ["arrowUp", "arrowDown", "circle", "square"] },
        "tone": { "type": "string", "enum": ["buy", "sell", "warn", "info"] },
        "text": { "type": "string" }
      }
    },
    "ChartAnchorLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "price", "title", "tone", "dashed"],
      "properties": {
        "id": { "type": "string" },
        "price": { "type": "string" },
        "title": { "type": "string" },
        "tone": { "type": "string", "enum": ["plan", "exit", "risk", "draw"] },
        "dashed": { "type": "boolean" }
      }
    },
    "CompactBar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_date", "open", "high", "low", "close", "volume"],
      "properties": {
        "trade_date": { "type": "string" },
        "open": { "type": "string" },
        "high": { "type": "string" },
        "low": { "type": "string" },
        "close": { "type": "string" },
        "volume": { "type": "string" }
      }
    },
    "RealtimeAdjustmentBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tilt_bps", "action_directive", "liquidity_filter_triggered",
        "risk_veto_reasons", "llm_model_used", "llm_status", "guard_message",
        "bull_points", "bear_points", "holding_plan"
      ],
      "properties": {
        "tilt_bps": { "type": "string" },
        "action_directive": { "type": "string", "enum": ["catalyst_boost", "tighten_stop_grid", "risk_veto", "neutral_monitor"] },
        "liquidity_filter_triggered": { "type": "boolean" },
        "risk_veto_reasons": { "type": "array", "items": { "type": "string" } },
        "llm_model_used": { "type": ["string", "null"] },
        "llm_status": { "type": "string" },
        "guard_message": { "type": "string" },
        "bull_points": { "type": "array", "items": { "type": "string" } },
        "bear_points": { "type": "array", "items": { "type": "string" } },
        "holding_plan": { "type": "string" }
      }
    },
    "NexusStockProAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id", "symbol", "display_name", "board_code", "release_id", "decision_as_of",
        "cached_in_postgres", "cache_key_hash", "timeframe", "adjustment_mode", "price_basis_note",
        "kline_bars", "multi_timeframe_ratings", "mtf_resonance_label", "mtf_resonance_score",
        "pivot_points", "vpvr", "pro_signals", "chart_lines", "chart_markers",
        "action_plan", "realtime_adjustment", "intraday_t_plan", "grid_plan",
        "retail_resonance", "seat_battle", "verified_news"
      ],
      "properties": {
        "instrument_id": { "type": "string", "format": "uuid" },
        "symbol": { "type": "string" },
        "display_name": { "type": "string" },
        "board_code": { "type": ["string", "null"] },
        "release_id": { "type": "string", "format": "uuid" },
        "decision_as_of": { "type": "string" },
        "cached_in_postgres": { "type": "boolean" },
        "cache_key_hash": { "type": "string" },
        "timeframe": { "type": "string" },
        "adjustment_mode": { "type": "string" },
        "price_basis_note": { "type": "string" },
        "kline_bars": { "type": "array", "items": { "$ref": "#/$defs/CompactBar" } },
        "multi_timeframe_ratings": { "type": "array", "items": { "$ref": "#/$defs/TimeframeTechnicalRating" } },
        "mtf_resonance_label": { "$ref": "#/$defs/RatingLabel" },
        "mtf_resonance_score": { "$ref": "#/$defs/DecStr" },
        "pivot_points": { "type": "array", "items": { "$ref": "#/$defs/PivotLevelSet" } },
        "vpvr": { "$ref": "#/$defs/VpvrProfile" },
        "pro_signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supertrend_dir", "supertrend_level", "volatility_squeeze", "bb_kc_squeeze_on",
            "squeeze_momentum", "adx_14", "anchored_vwap_20d", "rvol_20d",
            "macd_divergence", "rsi_divergence", "volume_patterns", "atr_14"
          ],
          "properties": {
            "supertrend_dir": { "type": "string", "enum": ["bullish", "bearish", "unavailable"] },
            "supertrend_level": { "$ref": "#/$defs/DecStr" },
            "volatility_squeeze": { "type": "string", "enum": ["squeeze_on", "squeeze_fired_up", "squeeze_fired_down", "normal", "unavailable"] },
            "bb_kc_squeeze_on": { "type": ["boolean", "null"] },
            "squeeze_momentum": { "$ref": "#/$defs/DecStr" },
            "adx_14": { "$ref": "#/$defs/DecStr" },
            "anchored_vwap_20d": { "$ref": "#/$defs/DecStr" },
            "rvol_20d": { "$ref": "#/$defs/DecStr" },
            "macd_divergence": { "type": "string", "enum": ["bullish_bottom_div", "bearish_top_div", "none"] },
            "rsi_divergence": { "type": "string", "enum": ["bullish_bottom_div", "bearish_top_div", "none"] },
            "volume_patterns": { "type": "array", "items": { "type": "string" } },
            "atr_14": { "$ref": "#/$defs/DecStr" }
          }
        },
        "chart_lines": { "type": "array", "items": { "$ref": "#/$defs/ChartAnchorLine" } },
        "chart_markers": { "type": "array", "items": { "$ref": "#/$defs/ChartSignalMarker" } },
        "action_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "composite_score", "entry_low", "entry_high", "stop_loss", "target_1", "target_2", "holding_sessions", "max_position_pct", "risk_vetoes", "pillar_scores", "rationale"],
          "properties": {
            "verdict": { "type": "string", "enum": ["strong_priority", "accumulate_on_dip", "hold_and_grid_t", "watch_wait", "risk_avoid"] },
            "composite_score": { "$ref": "#/$defs/DecStr" },
            "entry_low": { "$ref": "#/$defs/DecStr" },
            "entry_high": { "$ref": "#/$defs/DecStr" },
            "stop_loss": { "$ref": "#/$defs/DecStr" },
            "target_1": { "$ref": "#/$defs/DecStr" },
            "target_2": { "$ref": "#/$defs/DecStr" },
            "holding_sessions": { "type": "string" },
            "max_position_pct": { "type": "string" },
            "risk_vetoes": { "type": "array", "items": { "type": "string" } },
            "pillar_scores": {
              "type": "object",
              "additionalProperties": false,
